# Wird nur ausgewertet, wenn der Webserver .htaccess unterstützt (Apache).
ErrorDocument 404 /404.html
Options -Indexes

# Sicherheits-Header für alle Seiten. Unterordner mit eigener .htaccess (z. B. /ogsm/) ergänzen sie.
# HSTS bewusst ohne includeSubDomains/preload, damit Subdomains ohne Zertifikat nicht gesperrt werden.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "browsing-topics=()"
</IfModule>

# MyShotCoach heißt jetzt tennistrainer.app und läuft dort in einem eigenen Projekt
RedirectMatch 301 ^/myshotcoach/?(.*)$ https://tennistrainer.app/$1

# I feel the Vibe: offline, /vibe/ führt auf die Offline-Seite unter /vibe-v2/
RedirectMatch 302 ^/vibe(/.*)?$ /vibe-v2/

# Werbung lohnt sich ist offline (läuft nur noch lokal, siehe werbunglohntsich/README.md)
RedirectMatch 302 ^/werbunglohntsich(/.*)?$ /

# Firsty läuft auf der eigenen Subdomain firsty.toptop.shop (Dateien in /firsty-site/)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^firsty\.toptop\.shop$ [NC]
RewriteCond %{REQUEST_URI} !^/firsty-site/
RewriteRule ^(.*)$ /firsty-site/$1 [L]
RewriteCond %{HTTP_HOST} !^firsty\.toptop\.shop$ [NC]
RewriteRule ^(?:firsty|thirsty|firsty-site)(?:/(.*))?$ https://firsty.toptop.shop/$1 [R=302,L]

# Alte Adressen der ersten Version weiterleiten
Redirect 301 /impressum.html /impressum/
Redirect 301 /datenschutz.html /datenschutz/
Redirect 301 /braeunung/ratgeber.html /braeunung/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css image/svg+xml application/xml text/plain
</IfModule>
