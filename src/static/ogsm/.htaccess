Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /ogsm/404.html

# Passwortschutz (Basic Auth, beliebiger Benutzername). Bewusst ohne <IfModule>:
# fehlt mod_rewrite, antwortet der Server mit einem Fehler statt die Seite offen zu zeigen.
RewriteEngine On
RewriteCond expr "!(%{HTTP:Authorization} =~ /^Basic\s+(\S+)$/ && unbase64($1) =~ /^[^:]*:(.+)$/ && sha1('toptop-ogsm:$1') == '8029ef0dcc1c03a9361a9e14fb2a8dbfe0a78dab')"
RewriteRule ^ - [R=401,L]
Header always set WWW-Authenticate "Basic realm=\"OGSM Demo\", charset=\"UTF-8\"" "expr=%{REQUEST_STATUS} == 401"

# PGlite (Postgres im Browser) lädt WebAssembly und ein Datenpaket.
AddType application/wasm .wasm
AddType application/octet-stream .data

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/wasm application/octet-stream
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
